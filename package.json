{
  "name": "opencode-telegram",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run check --workspaces --if-present",
    "dev": "npm run dev --workspace @opencode-telegram/bridge",
    "start": "npm run start --workspace @opencode-telegram/bridge",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}

