# Set true only for isolated local development without Telegram or a tunnel.
ALLOW_INSECURE_LOCAL_DEV=false
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8787
# Optional agent instruction for image generation. Does not supply credentials
# or enforce a network sandbox: openai (direct only), or empty (no preference).
IMAGE_GENERATION_PROVIDER=
BRIDGE_DATABASE_PATH=./data/bridge.sqlite

OPENCODE_URL=http://127.0.0.1:4096
# WSL example for this repository. Never accept this value from the browser.
OPENCODE_DIRECTORY=/mnt/e/Projetos/Opencode telegram
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=

# Required together to enable Telegram Mini App authentication.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=
# Optional HTTPS URL used by notification buttons.
TELEGRAM_MINI_APP_URL=

